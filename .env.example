# Set these in the Vercel dashboard (Project → Settings → Environment Variables),
# then run `vercel env pull` locally. Do not hand-edit .env files.

# Vercel access token with read access to your projects + Web Analytics.
# Create at https://vercel.com/account/tokens
VERCEL_TOKEN=

# Only needed if the projects live under a Team (not your personal account).
# Team ID (team_xxx) or leave blank for personal-account projects.
VERCEL_TEAM_ID=

# Optional. Comma-separated project names (or ids) to omit from the digest —
# e.g. internal tools. Matched case-insensitively. Excluded projects are never
# queried. Example: EXCLUDED_PROJECTS=internal-admin,staging-sandbox
EXCLUDED_PROJECTS=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# From address must be on a domain verified in Resend.
REPORT_FROM=Analytics Digest <reports@yourdomain.com>
# Where the digest is delivered (comma-separated for multiple recipients).
REPORT_TO=kd@keegandonley.com

# Auto-provisioned by Vercel Blob (Storage → Blob). Enables the hosted report link.
BLOB_READ_WRITE_TOKEN=

# Set any value in Vercel; Vercel injects it as a Bearer token on cron requests,
# and the route rejects calls that don't present it.
CRON_SECRET=
