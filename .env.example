# Set these in Vercel under Project / Settings / Environment Variables.
# Run `vercel env pull` for local development. Do not hand-edit .env files.

# Optional. Use the public custom domain for canonical and social metadata.
# Vercel's production deployment domain is used automatically when omitted.
NEXT_PUBLIC_SITE_URL=

# Vercel access token with read access to your projects + Web Analytics.
# Create at https://vercel.com/account/tokens
VERCEL_TOKEN=

# Set this when the projects belong to a Team (not your personal account).
# Team ID (team_xxx) or leave blank for personal-account projects.
VERCEL_TEAM_ID=

# Optional. Comma-separated project names (or ids) to omit from the digest,
# such as internal tools. Matching ignores case. Excluded projects are not queried.
# Example: EXCLUDED_PROJECTS=internal-admin,staging-sandbox
EXCLUDED_PROJECTS=

# Resend: https://resend.com/api-keys
RESEND_API_KEY=

# From address must be on a domain verified in Resend.
REPORT_FROM=Analytics Digest <reports@yourdomain.com>
# Where the digest is delivered (comma-separated for multiple recipients).
REPORT_TO=you@example.com

# Optional. Whole hours from 1 through 24; defaults to 6. This controls both the
# delivery cadence and the current/previous analytics window sizes.
REPORT_INTERVAL_HOURS=6

# Optional: connecting a public Vercel Blob store provisions BLOB_STORE_ID.
# Vercel then supplies VERCEL_OIDC_TOKEN at runtime. Do not set either yourself.
# For a non-Vercel environment, a legacy token can be used as a fallback:
# BLOB_READ_WRITE_TOKEN=

# Set any value in Vercel; Vercel injects it as a Bearer token on cron requests,
# and the route rejects calls that don't present it.
CRON_SECRET=
